# ==============================================================
# ONE-TIME INITIAL LOAD — RAW ➜ HISTORY (insert-only, no logs)
# Trailing order enforced: ..., status, insert_ts, FLAG, ROW_HASH
# ==============================================================

from pyspark.sql import SparkSession, functions as F
from datetime import datetime
import pytz, traceback

spark = SparkSession.builder.appName("Initial Load RAW->HISTORY").getOrCreate()
spark.conf.set("spark.sql.session.timeZone", "UTC")
spark.conf.set("spark.sql.autoBroadcastJoinThreshold", -1)

tz = pytz.timezone("America/Chicago")
def _ts(): return datetime.now(tz).strftime("%Y-%m-%d %H:%M:%S")

CATALOG = "MHMR_LAKEHOUSE"
RAW_SCHEMA  = f"{CATALOG}.RAW"
HIST_SCHEMA = f"{CATALOG}.HISTORY"
TEMP_SCHEMA = f"{CATALOG}.HISTORY_TEMP"

spark.sql(f"CREATE SCHEMA IF NOT EXISTS {HIST_SCHEMA}")
spark.sql(f"CREATE SCHEMA IF NOT EXISTS {TEMP_SCHEMA}")

def _find_row_hash_name(cols):
    # return the actual column name from RAW (handles ROW_HASH vs Row_Hash etc.)
    for c in cols:
        if c.upper() == "ROW_HASH":
            return c
    raise ValueError("ROW_HASH column not found in RAW table")

def ensure_history_table(final_tbl: str, raw_df):
    if spark._jsparkSession.catalog().tableExists(final_tbl):
        return
    print(f"[{_ts()}] Creating missing history table with enforced order: {final_tbl}")

    row_hash_colname = _find_row_hash_name(raw_df.columns)
    raw_cols_wo_hash = [c for c in raw_df.columns if c != row_hash_colname]

    # IMPORTANT: carry ROW_HASH in the same select, then add new fields, then reorder
    schema_df = (
        raw_df.select(*raw_cols_wo_hash, F.col(row_hash_colname).alias("ROW_HASH"))
              .withColumn("status",    F.lit("I"))
              .withColumn("insert_ts", F.from_utc_timestamp(F.current_timestamp(), "America/Chicago"))
              .withColumn("FLAG",      F.lit("A"))
              .select(*raw_cols_wo_hash, "status", "insert_ts", "FLAG", "ROW_HASH")
    )
    schema_df.limit(0).write.mode("ignore").saveAsTable(final_tbl)

def load_one(row_dict):
    table_name = row_dict["TABLE_NAME"]
    raw_tbl   = f"{RAW_SCHEMA}.{table_name}_RAW"
    temp_tbl  = f"{TEMP_SCHEMA}.{table_name}_HIST_TEMP"
    final_tbl = f"{HIST_SCHEMA}.{table_name}_HIST"

    try:
        print(f"[{_ts()}] Reading {raw_tbl}")
        raw_df = spark.read.table(raw_tbl)

        ensure_history_table(final_tbl, raw_df)

        row_hash_colname = _find_row_hash_name(raw_df.columns)
        raw_cols_wo_hash = [c for c in raw_df.columns if c != row_hash_colname]

        # IMPORTANT: carry ROW_HASH in the same select, then add fields, then reorder
        out_df = (
            raw_df.select(*raw_cols_wo_hash, F.col(row_hash_colname).alias("ROW_HASH"))
                  .withColumn("status",    F.lit("I"))
                  .withColumn("insert_ts", F.from_utc_timestamp(F.current_timestamp(), "America/Chicago"))
                  .withColumn("FLAG",      F.lit("A"))
                  .select(*raw_cols_wo_hash, "status", "insert_ts", "FLAG", "ROW_HASH")
        )

        print(f"[{_ts()}] Writing temp history for {table_name}")
        out_df.write.mode("overwrite").saveAsTable(temp_tbl)

        # Insert by explicit column list (maps by name; avoids position/type issues)
        final_cols = [f.name for f in spark.table(final_tbl).schema]
        col_list = ", ".join(final_cols)
        print(f"[{_ts()}] Inserting rows into {final_tbl}")
        spark.sql(f"INSERT INTO {final_tbl} ({col_list}) SELECT {col_list} FROM {temp_tbl}")

        spark.sql(f"DROP TABLE IF EXISTS {temp_tbl}")
        print(f"[{_ts()}] DONE {table_name}")

    except Exception as e:
        print(f"[{_ts()}] FAILED {table_name}: {e}")
        traceback.print_exc()
        try: spark.sql(f"DROP TABLE IF EXISTS {temp_tbl}")
        except: pass

def run_initial_history_load(max_workers=4):
    print(f"[{_ts()}] Reading TABLES_LIST …")
    tables_df = spark.read.table("TABLES_LIST")
    rows = [r.asDict() for r in tables_df.collect()]

    from concurrent.futures import ThreadPoolExecutor, as_completed
    with ThreadPoolExecutor(max_workers=max_workers) as ex:
        futs = [ex.submit(load_one, r) for r in rows]
        for f in as_completed(futs):
            f.result()

if __name__ == "__main__":
    run_initial_history_load(max_workers=4)
